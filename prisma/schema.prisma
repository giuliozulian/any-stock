generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Stock {
  id              String                  @id @default(cuid())
  symbol          String                  @unique
  name            String
  exchange        String
  addedAt         DateTime                @default(now())
  entryPrice       Float?
  sellPrice        Float?
  entryTriggeredAt DateTime?
  sellTriggeredAt  DateTime?
  nextEarningsDate        DateTime?
  nextEarningsHour        String?
  nextEarningsEpsEstimate Float?
  earningsCheckedAt       DateTime?
  snapshots       PriceSnapshot[]
  news            NewsItem[]
  recommendations AnalystRecommendation[]
  insight         StockInsight?
  verdictNote     StockVerdictNote?
  earningsNote    StockEarningsNote?
  bullBearNote    StockBullBearNote?
}

model PriceSnapshot {
  id              String   @id @default(cuid())
  stockId         String
  stock           Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  price           Float
  changePct       Float
  volume          BigInt?
  marketCap       Float?
  peRatio         Float?
  week52High      Float?
  week52Low       Float?
  pegRatio        Float?
  roe             Float?
  netMargin       Float?
  debtToEquity    Float?
  dividendYield   Float?
  payoutRatio     Float?
  relativePerf13W Float?
  epsTTM          Float?
  epsGrowth5Y     Float?
  timestamp       DateTime @default(now())

  @@index([stockId, timestamp])
}

model NewsItem {
  id          String   @id @default(cuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  headline    String
  url         String
  source      String
  summary     String?
  publishedAt DateTime
  analysis    NewsAnalysis?

  // The same article can mention two watched stocks: it belongs to each of them.
  @@unique([stockId, url])
  @@index([stockId, publishedAt])
}

model AnalystRecommendation {
  id         String   @id @default(cuid())
  stockId    String
  stock      Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  period     DateTime
  strongBuy  Int
  buy        Int
  hold       Int
  sell       Int
  strongSell Int
  fetchedAt  DateTime @default(now())

  @@unique([stockId, period])
  @@index([stockId, period])
}

model NewsAnalysis {
  id         String   @id @default(cuid())
  newsItemId String   @unique
  newsItem   NewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  direction  String
  intensity  Int
  horizon    String
  scope      String
  confidence String
  rationale  String
  digest     String?
  model      String
  analyzedAt DateTime @default(now())
}

model StockInsight {
  id          String   @id @default(cuid())
  stockId     String   @unique
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  summary     String
  verdict     String
  score       Int
  keyPoints   String[]
  risks       String[]
  confidence  String
  inputHash   String
  model       String
  generatedAt DateTime @default(now())
}

model StockVerdictNote {
  id          String   @id @default(cuid())
  stockId     String   @unique
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  headline    String
  body        String
  watchFor    String[]
  inputHash   String
  model       String
  generatedAt DateTime @default(now())
}

model StockEarningsNote {
  id          String   @id @default(cuid())
  stockId     String   @unique
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  headline    String
  body        String
  watchFor    String[]
  inputHash   String
  model       String
  generatedAt DateTime @default(now())
}

model DiscoveredCandidate {
  id                String    @id @default(cuid())
  symbol            String    @unique
  name              String
  market            String
  score             Float
  momentumScore     Float
  fundamentalsScore Float
  insiderScore      Float
  reason            String
  source            String
  partial           Boolean   @default(false)
  scannedAt         DateTime  @default(now())
  dismissedAt       DateTime?
  aiVerdict         String?
  aiNote            String?
  aiCheckedAt       DateTime?

  @@index([score])
}

model StockBullBearNote {
  id          String   @id @default(cuid())
  stockId     String   @unique
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  bull        String[]
  bear        String[]
  inputHash   String
  model       String
  generatedAt DateTime @default(now())
}

model MoveExplanation {
  id          String   @id @default(cuid())
  symbol      String
  day         String
  changePct   Float
  explanation String
  confidence  String
  model       String
  generatedAt DateTime @default(now())

  @@unique([symbol, day])
}

model ScanRun {
  id          String       @id @default(cuid())
  status      String // 'running' | 'done'
  total       Int
  cursor      Int          @default(0)
  unreadCount Int          @default(0)
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  results     ScanResult[]

  @@index([status, finishedAt])
}

model ScanResult {
  id               String   @id @default(cuid())
  runId            String
  run              ScanRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  symbol           String
  name             String
  sector           String?
  status           String // 'ok' | 'unread'
  price            Float?
  barDate          DateTime?
  weightedReturn   Float?
  criteria         Json?
  rs               Float?
  passedCount      Int?
  vcpStatus        String?
  pivot            Float?
  pivotDistancePct Float?
  contractions     Json?
  volumeDryUp      Boolean?
  volumeRatio      Float?

  @@unique([runId, symbol])
  @@index([runId, passedCount])
}

model ScanAlert {
  id         String    @id @default(cuid())
  symbol     String    @unique
  armedAt    DateTime  @default(now())
  notifiedAt DateTime?
}

model ScannerAlertSettings {
  id          String   @id @default("default")
  newEntrants Boolean  @default(false)
  knownFull   String[]
  updatedAt   DateTime @updatedAt
}

// Responses from external services (prices, filings, videos, LLM text), shared by every server instance and every user.
model CacheEntry {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// Fixed-window request counters per user and bucket.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}
