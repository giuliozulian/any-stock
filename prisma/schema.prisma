generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Stock {
  id              String                  @id @default(cuid())
  symbol          String                  @unique
  name            String
  exchange        String
  createdAt       DateTime                @default(now())
  nextEarningsDate        DateTime?
  nextEarningsHour        String?
  nextEarningsEpsEstimate Float?
  earningsCheckedAt       DateTime?
  watchers        WatchlistEntry[]
  snapshots       PriceSnapshot[]
  news            NewsItem[]
  recommendations AnalystRecommendation[]
  insight         StockInsight?
  verdictNote     StockVerdictNote?
  earningsNote    StockEarningsNote?
  bullBearNote    StockBullBearNote?
}

model PriceSnapshot {
  id              String   @id @default(cuid())
  stockId         String
  stock           Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  price           Float
  changePct       Float
  volume          BigInt?
  marketCap       Float?
  peRatio         Float?
  week52High      Float?
  week52Low       Float?
  pegRatio        Float?
  roe             Float?
  netMargin       Float?
  debtToEquity    Float?
  dividendYield   Float?
  payoutRatio     Float?
  relativePerf13W Float?
  epsTTM          Float?
  epsGrowth5Y     Float?
  timestamp       DateTime @default(now())

  @@index([stockId, timestamp])
}

model NewsItem {
  id          String   @id @default(cuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  headline    String
  url         String
  source      String
  summary     String?
  publishedAt DateTime
  analysis    NewsAnalysis?

  // The same article can mention two watched stocks: it belongs to each of them.
  @@unique([stockId, url])
  @@index([stockId, publishedAt])
}

model AnalystRecommendation {
  id         String   @id @default(cuid())
  stockId    String
  stock      Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  period     DateTime
  strongBuy  Int
  buy        Int
  hold       Int
  sell       Int
  strongSell Int
  fetchedAt  DateTime @default(now())

  @@unique([stockId, period])
  @@index([stockId, period])
}

model NewsAnalysis {
  id         String   @id @default(cuid())
  newsItemId String   @unique
  newsItem   NewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  direction  String
  intensity  Int
  horizon    String
  scope      String
  confidence String
  rationale  String
  digest     String?
  model      String
  analyzedAt DateTime @default(now())
}

model StockInsight {
  id          String   @id @default(cuid())
  stockId     String   @unique
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  summary     String
  verdict     String
  score       Int
  keyPoints   String[]
  risks       String[]
  confidence  String
  inputHash   String
  model       String
  generatedAt DateTime @default(now())
}

model StockVerdictNote {
  id          String   @id @default(cuid())
  stockId     String   @unique
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  headline    String
  body        String
  watchFor    String[]
  inputHash   String
  model       String
  generatedAt DateTime @default(now())
}

model StockEarningsNote {
  id          String   @id @default(cuid())
  stockId     String   @unique
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  headline    String
  body        String
  watchFor    String[]
  inputHash   String
  model       String
  generatedAt DateTime @default(now())
}

model DiscoveredCandidate {
  id                String    @id @default(cuid())
  symbol            String    @unique
  name              String
  market            String
  score             Float
  momentumScore     Float
  fundamentalsScore Float
  insiderScore      Float
  reason            String
  source            String
  partial           Boolean   @default(false)
  scannedAt         DateTime  @default(now())
  dismissedAt       DateTime?
  aiVerdict         String?
  aiNote            String?
  aiCheckedAt       DateTime?
  // Snapshot at scan time, so the page lists candidates without calling any service.
  price             Float?
  changePct         Float?
  marketCap         Float?
  // Short warnings shown on the row: earnings close, already ran, others selling...
  flags             String[]  @default([])
  // Last ~60 daily closes, for the mini chart.
  spark             Json?
  firstSeenAt       DateTime  @default(now())
  // Score of the previous scan, to show whether the candidate is gaining or losing.
  prevScore         Float?

  @@index([score])
}

// One row per candidate per scan: the record that lets the page say how past proposals performed.
model DiscoveryHistory {
  id        String   @id @default(cuid())
  symbol    String
  scannedAt DateTime
  score     Float
  price     Float?

  @@index([symbol, scannedAt])
  @@index([scannedAt])
}

// A candidate a user hid: until a date, or for good when `until` is null. Per user, so one person's choice never hides ideas from another.
model DiscoveryDismissal {
  id        String    @id @default(cuid())
  userId    String
  symbol    String
  until     DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, symbol])
}

model StockBullBearNote {
  id          String   @id @default(cuid())
  stockId     String   @unique
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  bull        String[]
  bear        String[]
  inputHash   String
  model       String
  generatedAt DateTime @default(now())
}

model MoveExplanation {
  id          String   @id @default(cuid())
  symbol      String
  day         String
  changePct   Float
  explanation String
  confidence  String
  model       String
  // 'fact' = built from earnings/8-K data without an LLM, 'ai' = written by the model from news.
  kind        String   @default("ai")
  // [{ title, url }] the explanation is based on, so the reader can check it.
  sources     Json     @default("[]")
  generatedAt DateTime @default(now())

  @@unique([symbol, day])
}

model ScanRun {
  id          String       @id @default(cuid())
  status      String // 'running' | 'done'
  total       Int
  cursor      Int          @default(0)
  unreadCount Int          @default(0)
  // Watchlist and candidate stocks scanned on top of the S&P 500, fixed when the run starts so the cursor stays valid.
  extras      Json?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  results     ScanResult[]

  @@index([status, finishedAt])
}

// Stocks added to the scanner on top of the S&P 500, the watchlist and the candidates: the last Finviz list.
model ScanExtra {
  symbol  String   @id
  name    String
  source  String
  addedAt DateTime @default(now())
}

model ScanResult {
  id               String   @id @default(cuid())
  runId            String
  run              ScanRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  symbol           String
  name             String
  sector           String?
  status           String // 'ok' | 'unread'
  price            Float?
  barDate          DateTime?
  weightedReturn   Float?
  criteria         Json?
  rs               Float?
  passedCount      Int?
  vcpStatus        String?
  pivot            Float?
  pivotDistancePct Float?
  contractions     Json?
  volumeDryUp      Boolean?
  volumeRatio      Float?

  @@unique([runId, symbol])
  @@index([runId, passedCount])
}

model ScanAlert {
  id         String    @id @default(cuid())
  userId     String
  userEmail  String?
  symbol     String
  armedAt    DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([userId, symbol])
}

// One row per user: each person chooses for themselves whether to hear about new 8-of-8 stocks.
model ScannerAlertSettings {
  userId      String   @id
  userEmail   String?
  newEntrants Boolean  @default(false)
  knownFull   String[]
  updatedAt   DateTime @updatedAt
}

// Responses from external services (prices, filings, videos, LLM text), shared by every server instance and every user.
model CacheEntry {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// Fixed-window request counters per user and bucket.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

// One user's view of a stock: when they started watching it and the price targets they set. Prices, news and analyses live on Stock and are shared.
model WatchlistEntry {
  id               String    @id @default(cuid())
  userId           String
  userEmail        String?
  stockId          String
  stock            Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  addedAt          DateTime  @default(now())
  // The user's own order, set by dragging. Empty until the first reorder: such entries come last, by addedAt.
  position         Int?
  entryPrice       Float?
  sellPrice        Float?
  entryTriggeredAt DateTime?
  sellTriggeredAt  DateTime?

  @@unique([userId, stockId])
  @@index([stockId])
}

model MinerviniAiNote {
  id            String   @id @default(cuid())
  symbol        String
  // UTC day as YYYY-MM-DD: one analysis per symbol and day.
  day           String
  inputHash     String
  result        Json
  model         String
  promptVersion Int
  generatedAt   DateTime @default(now())

  @@unique([symbol, day])
}
