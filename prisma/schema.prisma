generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Stock {
  id              String                  @id @default(cuid())
  symbol          String                  @unique
  name            String
  exchange        String
  addedAt         DateTime                @default(now())
  entryPrice       Float?
  sellPrice        Float?
  entryTriggeredAt DateTime?
  sellTriggeredAt  DateTime?
  nextEarningsDate        DateTime?
  nextEarningsHour        String?
  nextEarningsEpsEstimate Float?
  earningsCheckedAt       DateTime?
  snapshots       PriceSnapshot[]
  news            NewsItem[]
  recommendations AnalystRecommendation[]
  insight         StockInsight?
}

model PriceSnapshot {
  id              String   @id @default(cuid())
  stockId         String
  stock           Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  price           Float
  changePct       Float
  volume          BigInt?
  marketCap       Float?
  peRatio         Float?
  week52High      Float?
  week52Low       Float?
  pegRatio        Float?
  roe             Float?
  netMargin       Float?
  debtToEquity    Float?
  dividendYield   Float?
  payoutRatio     Float?
  relativePerf13W Float?
  epsTTM          Float?
  epsGrowth5Y     Float?
  timestamp       DateTime @default(now())

  @@index([stockId, timestamp])
}

model NewsItem {
  id          String   @id @default(cuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  headline    String
  url         String   @unique
  source      String
  summary     String?
  publishedAt DateTime
  analysis    NewsAnalysis?

  @@index([stockId, publishedAt])
}

model AnalystRecommendation {
  id         String   @id @default(cuid())
  stockId    String
  stock      Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  period     DateTime
  strongBuy  Int
  buy        Int
  hold       Int
  sell       Int
  strongSell Int
  fetchedAt  DateTime @default(now())

  @@unique([stockId, period])
  @@index([stockId, period])
}

model NewsAnalysis {
  id         String   @id @default(cuid())
  newsItemId String   @unique
  newsItem   NewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  direction  String
  intensity  Int
  horizon    String
  scope      String
  confidence String
  rationale  String
  model      String
  analyzedAt DateTime @default(now())
}

model StockInsight {
  id          String   @id @default(cuid())
  stockId     String   @unique
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  summary     String
  verdict     String
  score       Int
  keyPoints   String[]
  risks       String[]
  confidence  String
  inputHash   String
  model       String
  generatedAt DateTime @default(now())
}
