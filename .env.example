# Avvisi di prezzo via email: SMTP (consigliato) oppure Resend
ALERT_EMAIL_TO="you@example.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
# Gmail: serve una "password per le app" (account con verifica in 2 passaggi)
SMTP_PASS="your-app-password"
# Opzionale (default: SMTP_USER)
# ALERT_EMAIL_FROM="Any Stock <you@gmail.com>"
# In alternativa a SMTP:
# RESEND_API_KEY="your-resend-api-key"

